// capillary.fe
// Surface Evolver Script (https://kenbrakke.com/evolver/evolver.html) to predict fluid behavior in vertical tube.
// Capillary cross-section-center is placed at 0,0. z aligns with the long axis.
// Initialization of capillary radius with parameter "r_c".
// Initialization of capillary height with parameter "h_c"
// Initialization of initial filling height with parameter "h_i".
// The contact angle can be changed by altering "ca".
// Only the free interface is discretized and the contact angles diretly prescribed along the edges/contact line
// Constraints must be given regarding vertice/edge position to prevent penetration through walls.

parameter d_c = |-D_C-|
#define r_c (d_c/2)  // of tube
parameter h_c = |-H_C-|  // of tube
parameter x_m = |-X_M-|
#define h_i (h_c-x_m) // inital height
parameter ca = |-CA-|  // interior contact angle, degrees
parameter tens = 0.07275
parameter rho = 998.2
parameter no_osc_check = 1

gravity_constant 9.81

#define WALLT -tens*cos(ca*pi/180)

//-----------------------------------------------------------------------------------------------------------------------------------
// CONSTRAINTS

constraint 1 // the tube wall, for contact line
formula: sqrt(x^2 + y^2) = r_c
energy:
e1:  -WALLT*z*y/r_c
e2:   WALLT*z*x/r_c
e3:   0

constraint 2  // the tube wall, for display 
formula: sqrt(x^2 + y^2) = r_c

constraint 3 nonnegative
formula: z

constraint 4 nonnegative
formula: h_c-z

constraint 5 nonnegative // prevent geometry from breaking out of cylinder
formula: r_c - sqrt(x^2 + y^2)

//-----------------------------------------------------------------------------------------------------------------------------------
//DEFINE TRIANGULATION

vertices
// the meniscus
1  r_c*cos(0*pi/3) r_c*sin(0*pi/3) h_i constraint 1,3,4
2  r_c*cos(1*pi/3) r_c*sin(1*pi/3) h_i constraint 1,3,4
3  r_c*cos(2*pi/3) r_c*sin(2*pi/3) h_i constraint 1,3,4
4  r_c*cos(3*pi/3) r_c*sin(3*pi/3) h_i constraint 1,3,4
5  r_c*cos(4*pi/3) r_c*sin(4*pi/3) h_i constraint 1,3,4
6  r_c*cos(5*pi/3) r_c*sin(5*pi/3) h_i constraint 1,3,4
// bottom of tube
11  r_c*cos(0*pi/3) r_c*sin(0*pi/3) 0 constraint 2 fixed
12  r_c*cos(1*pi/3) r_c*sin(1*pi/3) 0 constraint 2 fixed
13  r_c*cos(2*pi/3) r_c*sin(2*pi/3) 0 constraint 2 fixed
14  r_c*cos(3*pi/3) r_c*sin(3*pi/3) 0 constraint 2 fixed
15  r_c*cos(4*pi/3) r_c*sin(4*pi/3) 0 constraint 2 fixed
16  r_c*cos(5*pi/3) r_c*sin(5*pi/3) 0 constraint 2 fixed
// top of tube
21  r_c*cos(0*pi/3) r_c*sin(0*pi/3) h_c constraint 2 fixed
22  r_c*cos(1*pi/3) r_c*sin(1*pi/3) h_c constraint 2 fixed
23  r_c*cos(2*pi/3) r_c*sin(2*pi/3) h_c constraint 2 fixed
24  r_c*cos(3*pi/3) r_c*sin(3*pi/3) h_c constraint 2 fixed
25  r_c*cos(4*pi/3) r_c*sin(4*pi/3) h_c constraint 2 fixed
26  r_c*cos(5*pi/3) r_c*sin(5*pi/3) h_c constraint 2 fixed

edges
// the meniscus
1   1 2 constraint 1,3,4
2   2 3 constraint 1,3,4
3   3 4 constraint 1,3,4
4   4 5 constraint 1,3,4
5   5 6 constraint 1,3,4
6   6 1 constraint 1,3,4
// the bottom of the tube
7   11 12  constraint 2 fixed bare no_refine
8   12 13  constraint 2 fixed bare no_refine
9   13 14  constraint 2 fixed bare no_refine
10  14 15  constraint 2 fixed bare no_refine
11  15 16  constraint 2 fixed bare no_refine
12  16 11  constraint 2 fixed bare no_refine
// top of the tube
13  21 22  constraint 2 fixed bare no_refine
14  22 23  constraint 2 fixed bare no_refine
15  23 24  constraint 2 fixed bare no_refine
16  24 25  constraint 2 fixed bare no_refine
17  25 26  constraint 2 fixed bare no_refine
18  26 21  constraint 2 fixed bare no_refine
// Verticals sides of tube
19  11 21  constraint 2 fixed bare no_refine
20  12 22  constraint 2 fixed bare no_refine
21  13 23  constraint 2 fixed bare no_refine
22  14 24  constraint 2 fixed bare no_refine
23  15 25  constraint 2 fixed bare no_refine
24  16 26  constraint 2 fixed bare no_refine

faces
1   1 2 3 4 5 6 tension tens constraint 3,4,5

bodies 
1    1  volume pi*r_c^2*h_i density rho

