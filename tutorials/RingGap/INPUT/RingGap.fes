// capillary.fe
// Surface Evolver Script (https://kenbrakke.com/evolver/evolver.html) to predict fluid behavior in vertical tube.
// Capillary cross-section-center is placed at 0,0. z aligns with the long axis.
// Initialization of capillary radius with parameter "r_c".
// Initialization of capillary height with parameter "h_g"
// Initialization of initial filling height with parameter "h_i".
// The contact angle can be changed by altering "ca".
// Only the free interface is discretized and the contact angles diretly prescribed along the edges/contact line
// Constraints must be given regarding vertice/edge position to prevent penetration through walls.

parameter d_i = |-D_I-|	// inner ring gap diameter
parameter w_g = |-W_G-|	// ring gap width
#define d_o (d_i+2*w_g)	// outer ring gap diameter
#define r_i (d_i/2)  	// inner radius
#define r_o (d_o/2)  	// outer radius
parameter h_g = |-H_G-|	// ring gap height
parameter x_m = |-X_M-|	// fill fraction
#define h_i (h_g-x_m) // initial height
parameter ca_i = |-CA_I-|  // interior contact angle inner wall, degrees
parameter ca_o = |-CA_O-|  // interior contact angle inner wall, degrees
parameter tens = 0.07275
parameter rho = 998.2

//gravity_constant 9.81

// gravity components
parameter G_vec_x = 0
parameter G_vec_y = 0
parameter G_vec_z = -1

parameter G_const = 9.81
parameter G_norm = 0

parameter G_x = 0
parameter G_y = 0
parameter G_z = 0

#define WALLT_i -tens*cos(ca_i*pi/180)
#define WALLT_o -tens*cos(ca_o*pi/180)

//-----------------------------------------------------------------------------------------------------------------------------------
// CONSTRAINTS

constraint 1  // inner ring gap wall contact line
formula: sqrt(x^2 + y^2) = r_i
energy:
e1:  -WALLT_i*z*y/r_i
e2:   WALLT_i*z*x/r_i
e3:   0

constraint 2  // outer ring gap wall contact line
formula: sqrt(x^2 + y^2) = r_o
energy:
e1:  -WALLT_o*z*y/r_o
e2:   WALLT_o*z*x/r_o
e3:   0

constraint 3  // inner ring gap wall, for display 
formula: sqrt(x^2 + y^2) = r_i

constraint 4  // outer ring gap wall, for display 
formula: sqrt(x^2 + y^2) = r_o

constraint 5 nonnegative
formula: z

constraint 6 nonnegative
formula: h_g-z

constraint 7 nonnegative // prevent geometry from breaking out of ring gap
formula: r_i + sqrt(x^2 + y^2)

constraint 8 nonnegative // prevent geometry from breaking out of ring gap
formula: r_o - sqrt(x^2 + y^2)

quantity arb_grav energy method facet_vector_integral global
vector_integrand:
q1:  0
q2:  0
q3: -rho*z*(G_x*x+G_y*y+G_z*abs(z)/2)

//-----------------------------------------------------------------------------------------------------------------------------------
//DEFINE TRIANGULATION

vertices
/**********************************************
*****************MOVING VERTICES***************
**********************************************/
// inner wall contact points
1		r_i*cos(0*pi/4) r_i*sin(0*pi/4) h_i constraint 1,5,6
2		r_i*cos(1*pi/4) r_i*sin(1*pi/4) h_i constraint 1,5,6
3		r_i*cos(2*pi/4) r_i*sin(2*pi/4) h_i constraint 1,5,6
4		r_i*cos(3*pi/4) r_i*sin(3*pi/4) h_i constraint 1,5,6
5		r_i*cos(4*pi/4) r_i*sin(4*pi/4) h_i constraint 1,5,6
6		r_i*cos(5*pi/4) r_i*sin(5*pi/4) h_i constraint 1,5,6
7		r_i*cos(6*pi/4) r_i*sin(6*pi/4) h_i constraint 1,5,6
8		r_i*cos(7*pi/4) r_i*sin(7*pi/4) h_i constraint 1,5,6
// inner wall free points
10		(r_i+0.1*w_g)*cos(0*pi/4+pi/8) (r_i+0.1*w_g)*sin(0*pi/4+pi/8) h_i constraint 1,5,6
20		(r_i+0.1*w_g)*cos(1*pi/4+pi/8) (r_i+0.1*w_g)*sin(1*pi/4+pi/8) h_i constraint 1,5,6
30		(r_i+0.1*w_g)*cos(2*pi/4+pi/8) (r_i+0.1*w_g)*sin(2*pi/4+pi/8) h_i constraint 1,5,6
40		(r_i+0.1*w_g)*cos(3*pi/4+pi/8) (r_i+0.1*w_g)*sin(3*pi/4+pi/8) h_i constraint 1,5,6
50		(r_i+0.1*w_g)*cos(4*pi/4+pi/8) (r_i+0.1*w_g)*sin(4*pi/4+pi/8) h_i constraint 1,5,6
60		(r_i+0.1*w_g)*cos(5*pi/4+pi/8) (r_i+0.1*w_g)*sin(5*pi/4+pi/8) h_i constraint 1,5,6
70		(r_i+0.1*w_g)*cos(6*pi/4+pi/8) (r_i+0.1*w_g)*sin(6*pi/4+pi/8) h_i constraint 1,5,6
80		(r_i+0.1*w_g)*cos(7*pi/4+pi/8) (r_i+0.1*w_g)*sin(7*pi/4+pi/8) h_i constraint 1,5,6
// outer wall contact points
100		r_o*cos(0*pi/4) r_o*sin(0*pi/4) h_i constraint 2,5,6
200		r_o*cos(1*pi/4) r_o*sin(1*pi/4) h_i constraint 2,5,6
300		r_o*cos(2*pi/4) r_o*sin(2*pi/4) h_i constraint 2,5,6
400		r_o*cos(3*pi/4) r_o*sin(3*pi/4) h_i constraint 2,5,6
500		r_o*cos(4*pi/4) r_o*sin(4*pi/4) h_i constraint 2,5,6
600		r_o*cos(5*pi/4) r_o*sin(5*pi/4) h_i constraint 2,5,6
700		r_o*cos(6*pi/4) r_o*sin(6*pi/4) h_i constraint 2,5,6
800		r_o*cos(7*pi/4) r_o*sin(7*pi/4) h_i constraint 2,5,6
// outer wall free points
1000	(r_o-0.1*w_g)*cos(0*pi/4+pi/8) (r_o-0.1*w_g)*sin(0*pi/4+pi/8) h_i constraint 2,5,6
2000	(r_o-0.1*w_g)*cos(1*pi/4+pi/8) (r_o-0.1*w_g)*sin(1*pi/4+pi/8) h_i constraint 2,5,6
3000	(r_o-0.1*w_g)*cos(2*pi/4+pi/8) (r_o-0.1*w_g)*sin(2*pi/4+pi/8) h_i constraint 2,5,6
4000	(r_o-0.1*w_g)*cos(3*pi/4+pi/8) (r_o-0.1*w_g)*sin(3*pi/4+pi/8) h_i constraint 2,5,6
5000	(r_o-0.1*w_g)*cos(4*pi/4+pi/8) (r_o-0.1*w_g)*sin(4*pi/4+pi/8) h_i constraint 2,5,6
6000	(r_o-0.1*w_g)*cos(5*pi/4+pi/8) (r_o-0.1*w_g)*sin(5*pi/4+pi/8) h_i constraint 2,5,6
7000	(r_o-0.1*w_g)*cos(6*pi/4+pi/8) (r_o-0.1*w_g)*sin(6*pi/4+pi/8) h_i constraint 2,5,6
8000	(r_o-0.1*w_g)*cos(7*pi/4+pi/8) (r_o-0.1*w_g)*sin(7*pi/4+pi/8) h_i constraint 2,5,6

/**********************************************
*************FIXED/DISPLAY VERTICES************
**********************************************/
// bottom inner circle
11  r_i*cos(0*pi/3) r_i*sin(0*pi/3) 0 constraint 3 fixed
12  r_i*cos(1*pi/3) r_i*sin(1*pi/3) 0 constraint 3 fixed
13  r_i*cos(2*pi/3) r_i*sin(2*pi/3) 0 constraint 3 fixed
