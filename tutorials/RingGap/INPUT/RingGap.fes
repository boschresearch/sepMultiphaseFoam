16  r_i*cos(5*pi/3) r_i*sin(5*pi/3) 0 constraint 3 fixed
// top inner circle
21  r_i*cos(0*pi/3) r_i*sin(0*pi/3) h_g constraint 3 fixed
22  r_i*cos(1*pi/3) r_i*sin(1*pi/3) h_g constraint 3 fixed
23  r_i*cos(2*pi/3) r_i*sin(2*pi/3) h_g constraint 3 fixed
24  r_i*cos(3*pi/3) r_i*sin(3*pi/3) h_g constraint 3 fixed
25  r_i*cos(4*pi/3) r_i*sin(4*pi/3) h_g constraint 3 fixed
26  r_i*cos(5*pi/3) r_i*sin(5*pi/3) h_g constraint 3 fixed
// bottom outer circle
31  r_o*cos(0*pi/3) r_o*sin(0*pi/3) 0 constraint 4 fixed
32  r_o*cos(1*pi/3) r_o*sin(1*pi/3) 0 constraint 4 fixed
33  r_o*cos(2*pi/3) r_o*sin(2*pi/3) 0 constraint 4 fixed
34  r_o*cos(3*pi/3) r_o*sin(3*pi/3) 0 constraint 4 fixed
35  r_o*cos(4*pi/3) r_o*sin(4*pi/3) 0 constraint 4 fixed
36  r_o*cos(5*pi/3) r_o*sin(5*pi/3) 0 constraint 4 fixed
// top outer circle
41  r_o*cos(0*pi/3) r_o*sin(0*pi/3) h_g constraint 4 fixed
42  r_o*cos(1*pi/3) r_o*sin(1*pi/3) h_g constraint 4 fixed
43  r_o*cos(2*pi/3) r_o*sin(2*pi/3) h_g constraint 4 fixed
44  r_o*cos(3*pi/3) r_o*sin(3*pi/3) h_g constraint 4 fixed
45  r_o*cos(4*pi/3) r_o*sin(4*pi/3) h_g constraint 4 fixed
46  r_o*cos(5*pi/3) r_o*sin(5*pi/3) h_g constraint 4 fixed

