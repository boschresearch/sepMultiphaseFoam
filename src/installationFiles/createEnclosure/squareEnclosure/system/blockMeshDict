FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

width	|-W_C-|;
envWidthFactor	5;
h_c		|-H_C-|;

// environment
xenvmin		#calc "-($envWidthFactor-1)/2*$width";
xenvmax		#calc "(($envWidthFactor-1)/2+1)*$width";
yenvmin		#calc "-($envWidthFactor-1)/2*$width";
yenvmax		#calc "(($envWidthFactor-1)/2+1)*$width";
zenvmin		$h_c; //capillary height
zenvmax		#calc "$h_c+$envWidthFactor*$width"; //capillary height + environment height = 0.05 + 0.02

//capillary
xcapmin		0;
xcapmax		$width;
ycapmin		0;
ycapmax		$width;
zcapmin		0;//#eval{$h_c-0.025}; //capillary height - minimal meniscus height - puffer = 0.03 - 0.02 - 0.005
zcapmax		$h_c; //capillary height

nd			20;		// number of cells across diameter/width
dx			#eval{$width/$nd};
nenvx			#calc "static_cast<int>(($xenvmax-($xenvmin))/$dx)";
nenvy			#calc "static_cast<int>(($yenvmax-($yenvmin))/$dx)";
nenvz			#calc "static_cast<int>(($zenvmax-($zenvmin))/$dx)";
ncapx			#calc "static_cast<int>(($xcapmax-($xcapmin))/$dx)";
ncapy			#calc "static_cast<int>(($ycapmax-($ycapmin))/$dx)";
ncapz			#calc "static_cast<int>(($zcapmax-($zcapmin))/$dx)";

vertices
(
    ($xenvmin $yenvmin $zenvmin) //0
    ($xenvmax $yenvmin $zenvmin) //1
    ($xenvmax $yenvmax $zenvmin) //2
    ($xenvmin $yenvmax $zenvmin) //3
    ($xenvmin $yenvmin $zenvmax) //4
    ($xenvmax $yenvmin $zenvmax) //5
    ($xenvmax $yenvmax $zenvmax) //6
    ($xenvmin $yenvmax $zenvmax) //7
    
    ($xcapmin $ycapmin $zcapmin) //8
    ($xcapmax $ycapmin $zcapmin) //9
    ($xcapmax $ycapmax $zcapmin) //10
    ($xcapmin $ycapmax $zcapmin) //11
    ($xcapmin $ycapmin $zcapmax) //12
    ($xcapmax $ycapmin $zcapmax) //13
    ($xcapmax $ycapmax $zcapmax) //14
    ($xcapmin $ycapmax $zcapmax) //15
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nenvx $nenvy $nenvz)
    simpleGrading (1 1 1)
	
	hex (8 9 10 11 12 13 14 15) ($ncapx $ncapy $ncapz)
    simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    env
    {
        type patch;
        faces
        (
            (1 2 6 5)
            (4 5 6 7)
            (0 4 7 3)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
    
    envBottom
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    
    capBottom
    {
        type wall;
        faces
        (
            (8 11 10 9)
        );
    }
    
    capSides
    {
        type wall;
        faces
        (
            (9 10 14 13)
            (8 12 15 11)
            (8 9 13 12)
            (11 15 14 10)
        );
    }
    
    capTop
    {
        type wall;
        faces
        (
            (12 13 14 15)
        );
    }
);

mergePatchPairs
(
	(capTop envBottom)
);


